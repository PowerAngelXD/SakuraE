func input(s: string) -> string {
    print(s);
    return input();
}

func a1() -> void {
    println("hello");
    return;
}

func a1(s: string) -> void {
    println(concat_string("k: ", s));
    return;
}

func fib(n: i32) -> i32 {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

func main() -> i32 {
    println("应用程序:");

    let counter: i32 = 0;
    let list: string[5];

    while (true) {
        let ln = input("[[这是输入框，对]]>> ");
        list[counter] = ln;
        counter ++;
        match (ln) {
            "hello" => {
                println("world");
            }
            "exit" => {
                println("拜拜了您嘞");
                break;
            }
            "wtf" => {
                println("wtf???");
            }
            default => {
                println(concat_string("your input: ", ln));
            }
        }
    }

    println("历史记录：");
    for (let i = 0; i < 5; i ++) {
        println(list[i]);
    }

    return 0;
}
